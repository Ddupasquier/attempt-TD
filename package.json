{
  "name": "attempt-td",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "kill-port 5173 5174 5175 4173 || true && vite",
    "build": "npm test && vite build",
    "preview": "vite preview",
    "dev:config": "node scripts/create-dev-config.js",
    "setup": "npm install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "clean": "rm -rf dist",
    "prepare": "husky install",
    "postinstall": "npm run verify"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "sass": "^1.77.0",
    "svelte": "^5.46.1",
    "vitest": "^3.2.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.0"
  }
}
